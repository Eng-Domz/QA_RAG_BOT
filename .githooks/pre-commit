#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ -n "${QA_RAG_PYTHON:-}" ] && [ -x "$QA_RAG_PYTHON" ]; then
    python_cmd="$QA_RAG_PYTHON"
elif [ -x ".venv/Scripts/python.exe" ]; then
    python_cmd=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    python_cmd=".venv/bin/python"
else
    echo "Missing .venv. Run the documented bootstrap steps before committing." >&2
    exit 1
fi

"$python_cmd" -m compileall -q ./*.py tests
"$python_cmd" -c "import sys, pytest; sys.path.insert(0, r'$repo_root'); raise SystemExit(pytest.main(['-q']))"
npm --prefix web run lint
npm --prefix web run typecheck
